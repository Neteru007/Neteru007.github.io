{
  "name": "magic-gallery",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "ng build --configuration production",
    "check:data": "node scripts/check-data.mjs",
    "stage": "node scripts/stage.mjs",
    "prebuild": "node scripts/version-data.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,css,scss}\" \"scripts/*.mjs\" \"tests/*.mjs\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,css,scss}\" \"scripts/*.mjs\" \"tests/*.mjs\" \"*.json\"",
    "test": "node --test tests/*.test.mjs",
    "check:structure": "node scripts/check-structure.mjs"
  },
  "dependencies": {
    "@angular/cdk": "22.2.4",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/material": "22.2.4",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@supabase/supabase-js": "2.57.4",
    "astronomy-engine": "^2.1.19",
    "bootstrap": "5.3.8",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "prettier": "3.6.2",
    "typescript": "~6.0.0"
  },
  "type": "module"
}
